# name: test/sql/field_metadata.test
# description: COPY TO Arrow IPC with key value metadata on individual fields
# group: [sql]

require nanoarrow

statement ok
COPY (SELECT 42 AS id, 'foo' AS label) TO '__TEST_DIR__/fields.arrows' (FORMAT ARROWS, KV_METADATA {'file_owner': 'test_suite'}, FIELD_METADATA {'ID': {'measurement_unit': 'row_count'}, 'label': {'language_code': 'english', 'raw_bytes': 'binary_value'::BLOB}})

query II
FROM read_arrow('__TEST_DIR__/fields.arrows')
----
42	foo

# The schema message carries every key and value
query I
SELECT bool_and(contains(hex(content), hex(needle))) FROM read_blob('__TEST_DIR__/fields.arrows'), (VALUES ('file_owner'), ('test_suite'), ('measurement_unit'), ('row_count'), ('language_code'), ('english'), ('raw_bytes'), ('binary_value')) t(needle)
----
true

statement error
COPY (SELECT 42 AS id) TO '__TEST_DIR__/error.arrows' (FORMAT ARROWS, FIELD_METADATA 'nope')
----
Expected field_metadata argument to be a STRUCT

statement error
COPY (SELECT 42 AS id) TO '__TEST_DIR__/error.arrows' (FORMAT ARROWS, FIELD_METADATA {'id': 'nope'})
----
Expected field_metadata entry for column "id" to be a STRUCT

statement error
COPY (SELECT 42 AS id) TO '__TEST_DIR__/error.arrows' (FORMAT ARROWS, FIELD_METADATA {'missing': {'measurement_unit': 'row_count'}})
----
Column "missing" in field_metadata is not among the written columns

statement error
COPY (SELECT 42 AS id) TO '__TEST_DIR__/error.arrows' (FORMAT ARROWS, FIELD_METADATA {'id': {'raw_bytes': '\xFF\xFE'::BLOB}})
----
Metadata value for key "raw_bytes" is not valid UTF-8
