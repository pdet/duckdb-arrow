# name: test/sql/field_metadata.test
# description: COPY TO Arrow IPC with key value metadata on individual fields
# group: [sql]

require nanoarrow

statement ok
COPY (SELECT 42 AS id, 'foo' AS label) TO '__TEST_DIR__/fields.arrows' (FORMAT ARROWS, KV_METADATA {'file_owner': 'test_suite'}, FIELD_METADATA {'ID': {'measurement_unit': 'row_count'}, 'label': {'language_code': 'english', 'raw_bytes': 'binary_value'::BLOB}})

query III
SELECT field_path, key, value FROM arrow_kv_metadata('__TEST_DIR__/fields.arrows') ORDER BY field_path NULLS FIRST, key
----
NULL	file_owner	test_suite
[id]	measurement_unit	row_count
[label]	language_code	english
[label]	raw_bytes	binary_value

statement error
COPY (SELECT 42 AS id) TO '__TEST_DIR__/error.arrows' (FORMAT ARROWS, FIELD_METADATA 'nope')
----
Expected field_metadata argument to be a STRUCT

statement error
COPY (SELECT 42 AS id) TO '__TEST_DIR__/error.arrows' (FORMAT ARROWS, FIELD_METADATA {'missing': {'measurement_unit': 'row_count'}})
----
Column "missing" in field_metadata is not among the written columns

statement error
COPY (SELECT 42 AS id) TO '__TEST_DIR__/error.arrows' (FORMAT ARROWS, FIELD_METADATA {'id': {'measurement_unit': NULL}})
----
Metadata value for key "measurement_unit" must not be NULL

statement error
COPY (SELECT 42 AS id) TO '__TEST_DIR__/error.arrows' (FORMAT ARROWS, FIELD_METADATA {'id': {'ARROW:extension:name': 'bogus'}})
----
Metadata key "ARROW:extension:name" is reserved

statement error
COPY (SELECT 42 AS id) TO '__TEST_DIR__/error.arrows' (FORMAT ARROWS, FIELD_METADATA {'id': {'raw_bytes': '\xFF\xFE'::BLOB}})
----
Metadata value for key "raw_bytes" is not valid UTF-8

statement error
COPY (SELECT 42 AS id) TO '__TEST_DIR__/error.arrows' (FORMAT ARROWS, FIELD_METADATA {'id': {'raw_bytes': 'a\x00b'::BLOB}})
----
Metadata value for key "raw_bytes" must not contain NUL bytes
