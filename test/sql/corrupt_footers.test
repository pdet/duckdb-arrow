# name: test/sql/corrupt_footers.test
# description: A footer that cannot be trusted falls back to the stream the file carries
# group: [sql]

require nanoarrow

test-env DATA_PATH {TEST_DIR}

# The first block wraps around when its offset and body length are summed
query III
SELECT count(*), sum(i), sum(j) FROM read_arrow('{WORKING_DIRECTORY}/data/corrupt/footer_block_overflow.arrow');
----
1000	499500	999000

# The first block is too short to hold a message prefix
query III
SELECT count(*), sum(i), sum(j) FROM read_arrow('{WORKING_DIRECTORY}/data/corrupt/footer_short_metadata.arrow');
----
1000	499500	999000

# The footer is the schema of record, so one spliced from another file fails as it does in pyarrow
statement error
SELECT count(*) FROM read_arrow('{WORKING_DIRECTORY}/data/corrupt/footer_schema_mismatch.arrow');
----
Expected continuation token

# A file without a footer is a partial copy, even when its stream section is complete
statement ok
COPY (SELECT i FROM range(2048) t(i)) TO '{DATA_PATH}/part.arrows' (FORMAT arrows);

statement ok
COPY (SELECT 'ARROW1\x00\x00'::BLOB || content FROM read_blob('{DATA_PATH}/part.arrows')) TO '{DATA_PATH}/cut.arrow' (FORMAT BLOB);

statement error
SELECT count(*) FROM read_arrow('{DATA_PATH}/cut.arrow');
----
is truncated, it has no footer

# The name of a remote file skips the footer, and the magic still asks for its end
statement ok
COPY (SELECT content FROM read_blob('{DATA_PATH}/cut.arrow')) TO '{DATA_PATH}/cut.arrows' (FORMAT BLOB);

statement error
SELECT count(*) FROM read_arrow('{DATA_PATH}/cut.arrows');
----
is truncated, it has no footer

# A file with no record batches has a footer without blocks, so its stream is read to its end
statement ok
COPY (SELECT 1 AS i WHERE false) TO '{DATA_PATH}/empty.arrow' (FORMAT arrow);

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/empty.arrow');
----
0

# A remote file reads its footer first, so the same checks keep it on the stream
foreach file footer_block_overflow footer_short_metadata

statement ok
COPY (SELECT content FROM read_blob('{WORKING_DIRECTORY}/data/corrupt/{file}.arrow')) TO '{DATA_PATH}/{file}.arrow' (FORMAT BLOB);

query III
SELECT count(*), sum(i), sum(j) FROM read_arrow('{DATA_PATH}/{file}.arrow');
----
1000	499500	999000

endloop
