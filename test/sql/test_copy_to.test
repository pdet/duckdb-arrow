# name: test/sql/test_copy_to.test
# description: test copy to functionality and options
# group: [sql]

# Require statement will ensure this test is run with this extension loaded
require nanoarrow

test-env DATA_PATH {TEST_DIR}

statement ok
CREATE TABLE test AS SELECT * FROM read_arrow('__WORKING_DIRECTORY__/data/test.arrows');

# Try extensions without the format options
statement ok
COPY test TO '{DATA_PATH}/test.arrows'

statement ok
COPY test TO '{DATA_PATH}/test.arrow'

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/test.arrows');
----
15487

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/test.arrows');
----
15487

# Lets test the writing options
# row_group_size: The size of a row group. By default, the value is 122,880. A lower value may reduce performance but can be beneficial for streaming.

statement ok
COPY test TO '{DATA_PATH}/test_row_group.arrow' (row_group_size 10)

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/test_row_group.arrow');
----
15487

statement ok
COPY test TO '{DATA_PATH}/test_row_group.arrow' (chunk_size 10)

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/test_row_group.arrow');
----
15487

statement ok
COPY test TO '{DATA_PATH}/test_row_group.arrow' (row_group_size 100, chunk_size 10)

statement ok
COPY test TO '{DATA_PATH}/test_row_group.arrow' (row_group_size_bytes 100)

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/test_row_group.arrow');
----
15487

statement ok
SET preserve_insertion_order=false;

statement ok
COPY test TO '{DATA_PATH}/test_row_group.arrow' (row_group_size_bytes 100)

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/test_row_group.arrow');
----
15487

# This actually has a "minimum" of 2048
statement ok
COPY test TO '{DATA_PATH}/test_row_group_folder' (chunk_size 10, row_groups_per_file 1, FORMAT ARROW)

query I
select count(file) from glob('{DATA_PATH}/test_row_group_folder/*');
----
8

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/test_row_group_folder/*');
----
15487

statement ok
COPY test TO '{DATA_PATH}/data_kv.arrow' (kv_metadata {'test':'works'})

query I
SELECT count(*) FROM read_arrow('{DATA_PATH}/data_kv.arrow');
----
15487
