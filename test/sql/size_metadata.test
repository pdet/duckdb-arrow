# name: test/sql/size_metadata.test
# description: Arrow IPC size metadata and option validation
# group: [sql]

require nanoarrow

statement ok
SET threads = 1;

statement ok
CREATE TABLE size_source AS
SELECT CASE WHEN i % 3 = 0 THEN NULL ELSE 42::INTEGER END AS n
FROM range(4099) t(i);

foreach compression uncompressed zstd lz4

statement ok
COPY size_source TO '__TEST_DIR__/sizes_${compression}.arrow' (ROW_GROUP_SIZE 2048, COMPRESSION '${compression}', SIZE_METADATA);

# Each batch holds a NULL, full batches use 8448 bytes and the last three rows use 24
query III
WITH sizes AS (
    SELECT max(value::VARCHAR::BIGINT) FILTER (WHERE key = 'total_compressed_size') AS compressed_size,
           max(value::VARCHAR::BIGINT) FILTER (WHERE key = 'total_uncompressed_size') AS uncompressed_size
    FROM arrow_kv_metadata('__TEST_DIR__/sizes_${compression}.arrow')
    WHERE field_path IS NULL
)
SELECT uncompressed_size, compressed_size > 0,
       CASE WHEN '${compression}' = 'uncompressed' THEN compressed_size = uncompressed_size
            ELSE compressed_size < uncompressed_size END
FROM sizes;
----
16920	true	true

query III
SELECT count(*), count(n), sum(n) FROM read_arrow('__TEST_DIR__/sizes_${compression}.arrow');
----
4099	2732	114744

foreach rows 0 1

statement ok
COPY (SELECT NULL::INTEGER AS n WHERE ${rows} = 1) TO '__TEST_DIR__/small_${compression}_${rows}.arrow' (COMPRESSION '${compression}', SIZE_METADATA);

# One NULL row uses two padded buffers and compression adds two eight byte prefixes
query II
SELECT key, value::VARCHAR::BIGINT = ${rows} *
       CASE WHEN key = 'total_compressed_size' AND '${compression}' <> 'uncompressed' THEN 32 ELSE 16 END
FROM arrow_kv_metadata('__TEST_DIR__/small_${compression}_${rows}.arrow')
WHERE field_path IS NULL
ORDER BY key;
----
total_compressed_size	true
total_uncompressed_size	true

endloop

endloop

statement error
COPY (SELECT 1 AS i) TO '__TEST_DIR__/sizes.arrows' (SIZE_METADATA);
----
SIZE_METADATA requires the Arrow IPC file format

statement error
COPY (SELECT 1 AS i) TO '__TEST_DIR__/sizes.arrow' (SIZE_METADATA, KV_METADATA {'total_compressed_size': '1'});
----
KV_METADATA key "total_compressed_size" is written by SIZE_METADATA

statement error
COPY (SELECT 1 AS i) TO '__TEST_DIR__/sizes.arrow' (KV_METADATA {'total_uncompressed_size': '1'}, SIZE_METADATA);
----
KV_METADATA key "total_uncompressed_size" is written by SIZE_METADATA

statement error
COPY (SELECT 1 AS i) TO '__TEST_DIR__/sizes.arrow' (SIZE_METADATA (true, false));
----
SIZE_METADATA accepts at most one argument

statement error
COPY (SELECT 1 AS i) TO 's3://unused/sizes.arrow' (SIZE_METADATA);
----
SIZE_METADATA requires a seekable local output

statement ok
COPY (SELECT 1 AS i) TO '__TEST_DIR__/sizes.arrows' (SIZE_METADATA false, KV_METADATA {'total_compressed_size': 'custom'});

query II
SELECT key, value FROM arrow_kv_metadata('__TEST_DIR__/sizes.arrows') WHERE field_path IS NULL;
----
total_compressed_size	custom
