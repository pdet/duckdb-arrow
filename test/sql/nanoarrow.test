# name: test/sql/arrow.test
# description: test arrow extension
# group: [arrow]

# Before we load the extension, this will fail
statement error
SELECT arrow_version();
----
Catalog Error: Scalar Function with name arrow_version does not exist!

# Require statement will ensure this test is run with this extension loaded
require arrow

# Confirm the extension works
query I
SELECT nanoarrow_version();
----
0.7.0-SNAPSHOT
