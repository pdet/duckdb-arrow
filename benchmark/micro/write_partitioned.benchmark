# name: benchmark/micro/write_partitioned.benchmark
# description: Write sixteen partitions from one table
# group: [micro]

name Write partitioned
group micro

require nanoarrow

load
CREATE TABLE mixed AS SELECT *, id % 16 AS p FROM (SELECT i AS id, i % 1000 AS k, (i * 7919) % 100003 AS v, i / 7 AS d, 'item_' || (i % 50000) AS s FROM range(8000000) t(i));

run
COPY mixed TO '${BENCHMARK_DIR}/nanoarrow_write_partitioned' (FORMAT ARROWS, PARTITION_BY (p), OVERWRITE);

result I
8000000
