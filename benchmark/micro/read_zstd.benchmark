# name: benchmark/micro/read_zstd.benchmark
# description: Scan every column of TPCH lineitem compressed with zstd
# group: [micro]

name Read zstd
group micro

require nanoarrow

require tpch

cache_file nanoarrow_zstd_lineitem.arrows

load
CALL dbgen(sf=0.2);
COPY lineitem TO '${BENCHMARK_DIR}/nanoarrow_zstd_lineitem.arrows' (FORMAT ARROWS, COMPRESSION 'zstd');

run
SELECT max(COLUMNS(*)) FROM read_arrow('${BENCHMARK_DIR}/nanoarrow_zstd_lineitem.arrows');

result IIIIIIIIIIIIIIII
1200000	40000	2000	7	50.00	96949.50	0.10	0.08	R	O	1998-12-01	1998-10-31	1998-12-31	TAKE BACK RETURN	TRUCK	zzle? furiously iro
