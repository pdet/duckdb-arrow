# name: benchmark/micro/read_lz4.benchmark
# description: Scan every column of one file compressed with lz4
# group: [micro]

name Read lz4
group micro

require nanoarrow

cache_file nanoarrow_lz4_20m.arrows

load
COPY (SELECT i AS id, i % 1000 AS k, (i * 7919) % 100003 AS v, i / 7 AS d, 'item_' || (i % 50000) AS s FROM range(20000000) t(i)) TO '${BENCHMARK_DIR}/nanoarrow_lz4_20m.arrows' (FORMAT ARROWS, COMPRESSION 'lz4');

run
SELECT sum(id), sum(k), sum(v), max(d), max(s) FROM read_arrow('${BENCHMARK_DIR}/nanoarrow_lz4_20m.arrows');

result IIIII
199999990000000	9990000000	1000019852563	2857142.714285714	item_9999
