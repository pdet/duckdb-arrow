# name: benchmark/micro/write_lz4.benchmark
# description: Write one file compressed with lz4
# group: [micro]

name Write lz4
group micro

require nanoarrow

load
CREATE TABLE mixed AS SELECT i AS id, i % 1000 AS k, (i * 7919) % 100003 AS v, i / 7 AS d, 'item_' || (i % 50000) AS s FROM range(8000000) t(i);

# The runner's disk would dominate the timing, so the output goes nowhere
run
COPY mixed TO '/dev/null' (FORMAT ARROWS, COMPRESSION 'lz4');

result I
8000000
