# name: benchmark/micro/write_unordered.benchmark
# description: Write one file without preserving insertion order, which skips the batch copy
# group: [micro]

name Write unordered
group micro

require nanoarrow

load
SET preserve_insertion_order = false; CREATE TABLE mixed AS SELECT i AS id, i % 1000 AS k, (i * 7919) % 100003 AS v, i / 7 AS d, 'item_' || (i % 50000) AS s FROM range(8000000) t(i);

run
COPY mixed TO '${BENCHMARK_DIR}/nanoarrow_write_unordered.arrows' (FORMAT ARROWS);

result I
8000000
