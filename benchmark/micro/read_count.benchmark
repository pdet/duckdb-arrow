# name: benchmark/micro/read_count.benchmark
# description: Count the rows of one file of 14,600 batches, which reads only their headers
# group: [micro]

name Read count
group micro

require nanoarrow

cache_file nanoarrow_small_batches.arrows

load
COPY (SELECT i::INTEGER AS i FROM range(30000000) t(i)) TO '${BENCHMARK_DIR}/nanoarrow_small_batches.arrows' (FORMAT ARROWS, ROW_GROUP_SIZE 2048);

run
SELECT count(*) FROM read_arrow('${BENCHMARK_DIR}/nanoarrow_small_batches.arrows');

result I
30000000
