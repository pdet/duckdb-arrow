# name: benchmark/micro/read_count.benchmark
# description: Count the rows of one file, which reads the message headers only
# group: [micro]

name Read count
group micro

require nanoarrow

cache_file nanoarrow_large_batches.arrows

load
COPY (SELECT i AS id, i % 1000 AS k, (i * 7919) % 100003 AS v, i / 7 AS d, 'item_' || (i % 50000) AS s FROM range(4000000) t(i)) TO '${BENCHMARK_DIR}/nanoarrow_large_batches.arrows' (FORMAT ARROWS);

run
SELECT count(*) FROM read_arrow('${BENCHMARK_DIR}/nanoarrow_large_batches.arrows');

result I
4000000
