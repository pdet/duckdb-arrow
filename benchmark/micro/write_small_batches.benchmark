# name: benchmark/micro/write_small_batches.benchmark
# description: Write one file of many small batches, where the cost per message dominates
# group: [micro]

name Write small batches
group micro

require nanoarrow

load
CREATE TABLE ints AS SELECT i::INTEGER AS i FROM range(150000000) t(i);

# The runner's disk would dominate the timing, so the output goes nowhere
run
COPY ints TO '/dev/null' (FORMAT ARROWS, ROW_GROUP_SIZE 2048);

result I
150000000
