# name: benchmark/micro/write_zstd.benchmark
# description: Write one file compressed with zstd
# group: [micro]

name Write zstd
group micro

require nanoarrow

load
CREATE TABLE mixed AS SELECT i AS id, i % 1000 AS k, (i * 7919) % 100003 AS v, i / 7 AS d, 'item_' || (i % 50000) AS s FROM range(20000000) t(i);

# The runner's disk would dominate the timing, so the output goes nowhere
run
COPY mixed TO '/dev/null' (FORMAT ARROWS, COMPRESSION 'zstd');

result I
20000000
