# name: benchmark/micro/write_zstd.benchmark
# description: Write TPCH lineitem compressed with zstd at the default level
# group: [micro]

name Write zstd
group micro

require nanoarrow

require tpch

load
CALL dbgen(sf=0.2);

# The runner's disk would dominate the timing, so the output goes nowhere
run
COPY lineitem TO '/dev/null' (FORMAT ARROWS, COMPRESSION 'zstd');

result I
1199969
